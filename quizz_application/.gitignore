# -----------------------------------------------------------------------------
# Environment files and local configuration
#
# Never commit credentials, tokens, private endpoints or machine-specific
# settings. Keep only the documented, sanitized example file.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
config/*.json
!config/env.example.json
*.local
*.secret
*.secrets
*.secret.*
*.secrets.*
*credentials*
*credential*
*service-account*
*firebase-adminsdk*
*.dart-define.json
google-services.json
GoogleService-Info.plist
firebase_options.dart

